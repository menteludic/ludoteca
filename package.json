{
  "name": "ludoteca",
  "version": "0.1.0",
  "private": true,
  "description": "Game lending system for association events: catalogue, requests, counter and stats.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "c8 --check-coverage --lines 90 --exclude 'src/bootstrap/**' --exclude 'test/**' --reporter text --reporter text-summary npm test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "start": "node src/bootstrap/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "ramda": "^0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/ramda": "^0.32.0",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.3",
    "globals": "^17.14.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
